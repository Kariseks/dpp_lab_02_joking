<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pl.pwr.controller.MainWindowController">
   <top>
      <VBox alignment="CENTER" prefHeight="0.0" prefWidth="0.0" BorderPane.alignment="CENTER">
         <children>
            <MenuBar>
              <menus>
                <Menu mnemonicParsing="false" text="File">
                  <items>
                    <MenuItem mnemonicParsing="false" text="Close" />
                  </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Edit">
                  <items>
                    <MenuItem mnemonicParsing="false" text="Delete" />
                  </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Help">
                  <items>
                    <MenuItem mnemonicParsing="false" text="About" />
                  </items>
                </Menu>
              </menus>
            </MenuBar>
         </children>
      </VBox>
   </top>
   <center>
      <TabPane fx:id="mainTabPane" prefHeight="200.0" prefWidth="200.0" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
        <tabs>
          <Tab id="searchTab" fx:id="searchTab" text="Wyszukiwarka">
              <content>
                  <fx:include fx:id="searchTabContent" source="wyszukiwarka-view.fxml" />
              </content>
          </Tab>
          <Tab id="displayTab" fx:id="displayTab" closable="false" text="Wyświetl">
              <content>
                  <fx:include fx:id="displayTabContent" source="wyswietl-view.fxml" />
              </content>
          </Tab>
            <Tab id="addJokeTab" fx:id="addJokeTab" text="Dodaj">
                <content>
                    <fx:include fx:id="addJokeTabContent" source="dodaj-view.fxml" />
                </content>
            </Tab>
            <Tab id="historyTab" fx:id="historyTab" text="Historia">
                <content>
                    <fx:include fx:id="historyTabContent" source="historia-view.fxml" />
                </content>
            </Tab>
            <Tab id="statisticTab" fx:id="statisticTab" text="Statystyki">
                <content>
                    <fx:include fx:id="statisticTabContent" source="statystyki-view.fxml" />
                </content>
            </Tab>
            <Tab id="adminTab" fx:id="adminTab" text="Admin" >
                <content>
                    <fx:include fx:id="adminTabContent" source="adminTab-view.fxml" />
                </content>
            </Tab>

        </tabs>
      </TabPane>
   </center>
</BorderPane>
